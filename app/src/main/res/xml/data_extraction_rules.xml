<?xml version="1.0" encoding="utf-8"?>
<!--
   数据提取规则（适用于 API 31+）
   包含 Room 数据库和 DataStore 偏好，确保重装 App 后数据不丢失。
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="dance_timer.db"/>
        <include domain="database" path="dance_timer.db-shm"/>
        <include domain="database" path="dance_timer.db-wal"/>
        <include domain="file" path="../datastore/dance_timer_prefs.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="dance_timer.db"/>
        <include domain="database" path="dance_timer.db-shm"/>
        <include domain="database" path="dance_timer.db-wal"/>
        <include domain="file" path="../datastore/dance_timer_prefs.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>